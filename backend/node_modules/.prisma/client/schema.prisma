generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  RECEPTIONIST
  SERVICE_ADVISOR
  MECHANIC
  ACCOUNTANT
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  phone    String?
  role     Role    @default(MECHANIC)
  isActive Boolean @default(true)

  // Mechanic specific
  skills       String?
  experience   Int?
  rating       Float?  @default(0)
  profileImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedJobs JobCard[] @relation("MechanicJobs")
  advisedJobs  JobCard[] @relation("AdvisorJobs")
}

model Customer {
  id              Int     @id @default(autoincrement())
  name            String
  mobile          String  @unique
  alternateMobile String?
  email           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  gstNumber       String?
  notes           String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
  jobCards JobCard[]
}

model Vehicle {
  id               Int       @id @default(autoincrement())
  vehicleNumber    String    @unique
  brand            String
  model            String
  variant          String?
  fuelType         String?
  transmission     String?
  year             Int?
  registrationDate DateTime?
  engineNumber     String?
  chassisNumber    String?
  odometer         Int?
  insuranceExpiry  DateTime?
  pucExpiry        DateTime?

  rcImage        String?
  insuranceImage String?
  vehicleImages  String? @db.Text // Comma separated or JSON string

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobCards JobCard[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  INSPECTION
  IN_PROGRESS
  WAITING_FOR_PARTS
  WASHING
  QUALITY_CHECK
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model JobCard {
  id        Int    @id @default(autoincrement())
  jobNumber String @unique

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  advisorId Int?
  advisor   User? @relation("AdvisorJobs", fields: [advisorId], references: [id])

  mechanicId Int?
  mechanic   User? @relation("MechanicJobs", fields: [mechanicId], references: [id])

  status BookingStatus @default(PENDING)

  complaints       String? @db.Text
  vehicleCondition String? @db.Text
  fuelLevel        Int?
  accessories      String? @db.Text

  estimatedDelivery DateTime?
  estimatedCost     Float?

  labourCharges  Float? @default(0)
  partsCharges   Float? @default(0)
  discount       Float? @default(0)
  tax            Float? @default(0)
  totalAmount    Float? @default(0)
  advancePayment Float? @default(0)

  beforeImages String? @db.Text
  afterImages  String? @db.Text

  digitalSignature String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspection Inspection?
  invoice    Invoice?
}

model Inspection {
  id        Int     @id @default(autoincrement())
  jobCardId Int     @unique
  jobCard   JobCard @relation(fields: [jobCardId], references: [id])

  engine     String?
  battery    String?
  oilLevel   String?
  brake      String?
  clutch     String?
  gear       String?
  suspension String?
  steering   String?
  horn       String?
  headlight  String?
  indicators String?
  tyres      String?
  coolant    String?
  ac         String?
  wiper      String?
  mirror     String?

  photos String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServicePackage {
  id               Int     @id @default(autoincrement())
  name             String
  price            Float
  duration         Int
  description      String? @db.Text
  includedParts    String? @db.Text
  includedServices String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inventory {
  id         Int       @id @default(autoincrement())
  partName   String
  sku        String    @unique
  brand      String?
  category   String?
  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  purchasePrice   Float
  sellingPrice    Float
  gst             Float   @default(0)
  quantity        Int     @default(0)
  minimumQuantity Int     @default(5)
  rackNumber      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id            Int     @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstNumber     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory[]
}

model Invoice {
  id            Int     @id @default(autoincrement())
  invoiceNumber String  @unique
  jobCardId     Int     @unique
  jobCard       JobCard @relation(fields: [jobCardId], references: [id])

  paymentStatus String  @default("PENDING")
  paymentMethod String?

  subtotal       Float
  taxAmount      Float
  discountAmount Float
  totalAmount    Float
  paidAmount     Float @default(0)

  pdfUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
